@inherits LayoutComponentBase

<nav class="rail" aria-label="Основная навигация">
    <img class="rail__mark"
         src="./images/rail-mark.webp"
         alt="Лабиринт"
         title="Лабиринт – MaxNagibator эдишен"
         width="34"
         height="34" />

    <NavMenu />

    <div class="ui-spacer"></div>

    <IconButton Icon="@IconCatalog.Theme"
                OnClick="@ToggleThemeAsync"
                Title="Сменить тему" />
    <IconButton Icon="@IconCatalog.Gear"
                OnClick="@OpenParametersAsync"
                Title="Настройки" />
</nav>

<main>
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent>
            <div class="ui-stack ui-stack--4">
                <Alert Severity="UiSeverity.Error">Что-то сломалось. Подробности в консоли браузера.</Alert>
                <div class="ui-row">
                    <Button OnClick="@Reload">Перезагрузить</Button>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<DialogHost />
<ToastHost />
<UpdateBanner />
