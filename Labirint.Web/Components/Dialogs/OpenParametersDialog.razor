@using Labirint.Web.Parameters

<Dialog>
    <ChildContent>
        <div class="ui-stack ui-stack--6">
            <ControlSchemeSwitcher @bind-Value="_controlScheme" />

            <div class="ui-stack">
                <Switch @bind-Value="_parameters.IsSoundOn"
                        Label="Звук" />
                @if (_parameters.IsSoundOn)
                {
                    <Slider @bind-Value="_parameters.SoundVolume"
                            Label="Громкость"
                            Max="1f"
                            Min="0f"
                            Step="0.01f"
                            T="float"
                            ValueLabelFormat="0%" />
                }
            </div>

            <ColorField @bind-Value="_parameters.Color"
                        FallbackValue="@LabyrinthParameters.DefaultColor"
                        Label="Цвет лабиринта" />
        </div>
    </ChildContent>
    <Actions>
        <Button Disabled="_isProcessing"
                OnClick="Reset"
                Variant="UiVariant.Text">
            Сбросить
        </Button>

        <div class="ui-spacer"></div>

        <Button OnClick="Cancel">Отмена</Button>
        <Button Disabled="_isProcessing"
                OnClick="UpdateAsync"
                Tone="UiTone.Accent"
                Variant="UiVariant.Filled">
            @if (_isProcessing)
            {
                <Spinner IsDecorative
                         Size="18" />
            }
            else
            {
                <span>Сохранить</span>
            }
        </Button>
    </Actions>
</Dialog>
