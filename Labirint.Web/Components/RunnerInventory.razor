@inherits RenderComponent

<div class="ui-row ui-row--wrap">
    @foreach (var animatedStack in _animator.Stacks)
    {
        var stack = animatedStack.Stack;

        if (stack.Count <= 0 && animatedStack.IsIdle)
        {
            continue;
        }

        <InventorySlot @key="stack.Item"
                       KeySymbol="@GetKeySymbol(stack.Item)"
                       OnLore="ShowLoreAsync"
                       OnUse="OnClicked"
                       Stack="animatedStack" />
    }
</div>
