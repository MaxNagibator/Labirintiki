<div class="ui-field @Class">
    @if (string.IsNullOrEmpty(Label) == false)
    {
        <label class="ui-field__label" for="@_hexId">@Label</label>
    }

    <div class="ui-row ui-row--2">
        <input id="@_pickerId"
               class="ui-color__picker"
               type="color"
               value="@_rgb"
               aria-label="@PickerLabel"
               @onchange="OnPickerChangedAsync" />

        <input @key="_hexRevision"
               id="@_hexId"
               class="ui-input ui-color__hex"
               type="text"
               value="@_hex"
               spellcheck="false"
               autocomplete="off"
               aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
               @onchange="OnHexChangedAsync" />
    </div>

    @if (ShowAlpha)
    {
        <div class="ui-stack ui-stack--1 ui-color__alpha">
            <div class="ui-row ui-row--between ui-row--2">
                <label class="ui-field__label" for="@_alphaId">Прозрачность</label>
                <span class="t-label t-data">@AlphaText</span>
            </div>

            <input id="@_alphaId"
                   class="ui-range"
                   type="range"
                   min="0"
                   max="1"
                   step="0.01"
                   value="@AlphaValue"
                   @oninput="OnAlphaChangedAsync" />
        </div>
    }
</div>
