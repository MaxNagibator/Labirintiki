<div class="ui-row ui-row--wrap">
    @foreach (var ability in Abilities.Where(ability => ability.Active))
    {
        <div class="runner-ability-container">
            <div class="runner-ability">
                <img alt="@ability.Properties.DisplayName"
                     src="@ability.Properties.Icon">
                <div class="ability-name">@ability.Properties.DisplayName</div>
                @if (ability.Properties.IsUnlimitedMoveCount == false)
                {
                    <div class="ability-lost-count t-data"><span class="visually-hidden">Осталось ходов: </span>@ability.LostCount</div>
                }
            </div>
        </div>
    }
</div>
