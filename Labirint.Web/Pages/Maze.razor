@page "/labirint/{seed?}"
@inherits SafeComponent

<PageTitle>Лабиринт: партия</PageTitle>

<h1 class="visually-hidden">Лабиринт</h1>

<div aria-live="polite"
     class="visually-hidden">
    @foreach (var announcement in _announcements)
    {
        <div @key="announcement.Id">@announcement.Text</div>
    }
</div>

@if (IsBusy)
{
    <div class="loading ui-row ui-row--2">
        <Spinner />
        <span class="t-body">@LoadingText</span>
    </div>
}

<div class="workspace"
     hidden="@IsBusy">
    <div class="header-panel">
        @if (IsInit)
        {
            <div class="stat">
                <span class="t-label">Счёт</span>
                <span class="stat__value ui-row ui-row--2">
                    <Icon Name="@IconCatalog.Coin"
                          Size="26" />
                    <span class="t-data stat__number">@_displayScore.ToString("N0")</span>
                </span>
            </div>

            <div class="stat">
                <span class="t-label">Ходов</span>
                <span class="t-data stat__number stat__number--dim">@_session.MoveCount</span>
            </div>
        }

        <div class="ui-spacer"></div>

        <IconButton Icon="@IconCatalog.Settings"
                    OnClick="OpenSettings"
                    Size="22"
                    Title="Параметры лабиринта"
                    Variant="UiVariant.Outlined" />
    </div>

    @if (IsInit)
    {
        <div class="game">
            <div class="main-panel">
                @if (_session.Runner.Abilities.Any(ability => ability.Active))
                {
                    <div class="ability-panel">
                        <RunnerAbilities Abilities="@_session.Runner.Abilities" />
                    </div>
                }

                <MazeField AnimationClass="@AnimationService.EffectClass"
                           OnSwipe="OnSwipe"
                           Parameters="_session.Parameters"
                           @ref="_field" />

                <div class="inventory-panel">
                    <RunnerInventory Interceptor="_keyInterceptor"
                                     Inventory="_session.Runner.Inventory"
                                     @ref="_runnerInventory" />
                </div>
            </div>
        </div>
    }
</div>

<Sheet CloseTitle="Закрыть параметры"
       IsOpen="_isSettingsOpen"
       OnClose="CloseSettings"
       Title="Параметры лабиринта">
    <RandomGenerator Density="@_generatedDensity"
                     IsExitFound="@(_session?.IsExitFound ?? false)"
                     @ref="_seeder"
                     Seed="@Seed"
                     Size="@_generatedSize" />

    <div class="ui-stack ui-stack--2 param">
        <NumberField @bind-Value="_originalSize"
                     Class="param__number"
                     Label="Размер"
                     Max="MaxSize"
                     Min="MinSize" />
        <Slider AriaLabel="Размер"
                @bind-Value="_originalSize"
                Max="MaxSize"
                Min="MinSize"
                Step="1" />
    </div>

    <div class="ui-stack ui-stack--2 param">
        <NumberField @bind-Value="_density"
                     Class="param__number"
                     Label="Плотность"
                     Max="MaxDensity"
                     Min="MinDensity" />
        <Slider AriaLabel="Плотность"
                @bind-Value="_density"
                Max="MaxDensity"
                Min="MinDensity"
                Step="1" />
    </div>

    <Button FullWidth
            OnClick="GenerateAsync"
            StartIcon="@IconCatalog.Refresh"
            Tone="UiTone.Accent"
            Variant="UiVariant.Filled">
        Генерировать
    </Button>

    <hr class="ui-hairline" />

    <KeyInterceptor Inventory="_session?.Runner.Inventory"
                    @ref="_keyInterceptor" />
</Sheet>
